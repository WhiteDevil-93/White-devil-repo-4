{
  "name": "whitedevil-agent",
  "productName": "WhiteDevil",
  "version": "1.1.4",
  "description": "WhiteDevil Agent desktop app \u2014 Forge Hub is a domain; Shell/gallery/studio stay on the web surface.",
  "main": "main.cjs",
  "author": "WhiteDevil",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/config.test.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^37.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.whitedevil.agent",
    "productName": "WhiteDevil",
    "files": [
      "main.cjs",
      "preload.cjs",
      "config.cjs",
      "shell.html",
      "settings.html",
      "signin.html",
      "icon.png",
      "icon.svg"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "WhiteDevil.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WhiteDevil-Setup-${version}.exe"
    }
  }
}
